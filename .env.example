# Copy to .env and fill in. Never commit .env.

# ---- required ----------------------------------------------------------------
# Telegram bot token (@BotFather)
TG_BOT_TOKEN=123456789:xxxxxxxx
# Bale bot token (@botfather in Bale)
BALE_BOT_TOKEN=123456789:xxxxxxxx

# Admin user ids (comma separated) — they get the admin panel (/admin).
TG_ADMINS=463152143
BALE_ADMINS=606376358

# The bot is private. Besides the admins, only these users may use it (comma
# separated numeric ids); anyone else gets a short "private bot" notice showing
# their id, which they can send you. A link (channel pair) only syncs while one
# of its owners is an admin or listed here. Restart the bot after changing.
TG_ALLOWED_USERS=
BALE_ALLOWED_USERS=

# ---- optional ----------------------------------------------------------------
# SQLite database file (relative to the project folder).
#DB_PATH=data/bot.db

# Telegram updates use long polling by default (no domain or open port needed).
# To use a webhook instead, set a public https URL; the bot listens on HOST:PORT
# (put a reverse proxy with TLS in front) and accepts updates on the URL's path.
#TG_WEBHOOK_URL=https://bot.example.com/telegram-webhook
#HOST=0.0.0.0
#PORT=8080
# Checked on every webhook request; derived from TG_BOT_TOKEN when unset.
#TG_WEBHOOK_SECRET=

# API base URLs, e.g. a relay or a local Bot API server if the server can't
# reach the official ones directly.
#TG_API_URL=https://api.telegram.org
#BALE_API_URL=https://tapi.bale.ai

# Or send outgoing requests through an HTTP proxy (Node 22.21+ / 24.5+).
# Node reads these at process start: they work through Docker Compose and the
# systemd unit; with a bare `npm start`, export them in the shell instead.
#NODE_USE_ENV_PROXY=1
#HTTPS_PROXY=http://127.0.0.1:8118
#NO_PROXY=tapi.bale.ai

# ---- one-time migration from Telegram Serverless -----------------------------
# Only for `npm run import:tgcloud`
# (@BotFather → your bot → Serverless → CLI Access → Access token).
#TGCLOUD_TOKEN=app123456789:xxxxxxxx
